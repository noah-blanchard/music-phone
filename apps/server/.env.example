# Port the Elysia server listens on. Dokploy maps the domain to this port.
PORT=3001

# Allowed origin for the web client, used for both CORS and the WebSocket
# origin check. Use the web app's own URL in production, e.g.
# https://play.example.com (exact, no trailing slash). Defaults to "*", which
# allows any origin — convenient locally, never right in production.
WEB_ORIGIN=http://localhost:3000

# Where rooms are stored. Leave unset to keep them in memory, which is fine for
# local development but loses every in-progress game on restart — including on
# each deploy. Set this in production to the internal connection string of the
# Redis instance; use rediss:// for TLS.
# REDIS_URL=redis://localhost:6379

# Only used by the test suite: when set, the RoomStore contract suite also runs
# against a real Redis instead of skipping that half.
# REDIS_TEST_URL=redis://localhost:6379
