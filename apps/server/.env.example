# Port the Elysia server listens on (Render injects PORT automatically).
PORT=3001

# Allowed origin for the web client, used for both CORS and the WebSocket
# origin check. Use the Vercel URL in production, e.g.
# https://musicphone.vercel.app . Defaults to "*", which allows any origin —
# convenient locally, never right in production.
WEB_ORIGIN=http://localhost:3000

# Where rooms are stored. Leave unset to keep them in memory, which is fine for
# local development but loses every in-progress game on restart — including on
# each deploy, and whenever a free-tier host spins down after idling.
# Set this in production. Upstash and Render both provide a connection string;
# use rediss:// for TLS.
# REDIS_URL=redis://localhost:6379

# Only used by the test suite: when set, the RoomStore contract suite also runs
# against a real Redis instead of skipping that half.
# REDIS_TEST_URL=redis://localhost:6379
