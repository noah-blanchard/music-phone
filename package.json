{
  "name": "musicphone",
  "private": true,
  "version": "1.0.0",
  "description": "MusicPhone - a collaborative real-time music game (Gartic Phone, but with melodies).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "bun --filter @musicphone/server dev",
    "dev:web": "bun --filter @musicphone/web dev",
    "build": "bun --filter '*' build",
    "typecheck": "bun --filter '*' typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "bun run typecheck && bun run lint && bun run test"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript-eslint": "8.46.0",
    "vitest": "3.2.4"
  }
}
